# 可选：配置后启用 DeepSeek 大模型增强；不配置则使用本地规则 + 知识库
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 大模型调用加固（B 部分）────────────────────────────────
# 全部可省略，省略即使用括注默认值；调参后建议重跑 node scripts/ai/eval-b.mjs
# 注意：本文件不放行内注释，避免被 .env 解析器当作值的一部分

# 单次调用超时（9000；现场网络差可降到 5000）
LLM_TIMEOUT_MS=9000
# 可重试错误的退避重试次数（1）
LLM_MAX_RETRIES=1
# 连续失败多少次后熔断打开（3）
LLM_CIRCUIT_FAILURES=3
# 熔断冷却时长，之后半开试探（60000）
LLM_CIRCUIT_COOLDOWN_MS=60000
# 并发闸门，保护上游（4）
LLM_MAX_CONCURRENCY=4
# 相同请求的缓存有效时长，LRU（600000）
LLM_CACHE_TTL_MS=600000

# ── 知识库检索阈值（B 部分）────────────────────────────────
# 低于此分视为未命中（2.4）
KB_MIN_SCORE=2.4
# 高置信阈值：调高更准、自助覆盖率更低（4.5）
KB_CONFIDENT_SCORE=4.5
# 次优/最优 超过该比值判定为歧义并降级（0.85）
KB_AMBIGUITY_RATIO=0.85

# ── 风险筛查阈值（B 部分）──────────────────────────────────
# 融合分 ≥ 该值为高风险（7）
RISK_HIGH_SCORE=7
# 融合分 ≥ 该值为中风险（3.2）
RISK_MEDIUM_SCORE=3.2

# 服务端口
PORT=8787

# 前端（Vite）配置；复制到 .env.development / .env.production
VITE_API_BASE_URL=/api
VITE_USE_MOCK=true
